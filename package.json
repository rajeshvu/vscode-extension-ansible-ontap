{
  "name": "ansible-ontap-snippets",
  "displayName": "ONTAP Ansible Snippets",
  "description": "Search and insert NetApp ONTAP Ansible snippets inside VSCode",
  "version": "22.14.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "logo.png",
  "keywords": [
    "netapp",
    "ONTAP",
    "ansible-ontap",
    "ansible",
    "snippets",
    "storage",
    "automation"
  ],
  "license": "MIT",
  "licenseText": "MIT License\n\nCopyright (c) 2023 Rajesh V U",
  "publisher": "rajeshvu",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajeshvu/vscode-extension-ansible-ontap.git"
  },
  "activationEvents": [
      "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ansible-ontap-snippets.search-22.14.0",
        "title": "ONTAP Ansible Snippets - v22.14.0"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
